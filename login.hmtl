<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Acceso Galáctico - Star Wars</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { 
            background-color: #000; 
            color: #fff; 
            height: 100vh; 
            display: flex; 
            align-items: center; 
            justify-content: center;
            font-family: 'Arial', sans-serif;
        }
        .login-card { 
            background: #111; 
            border: 1px solid #ffe81f; 
            padding: 40px; 
            border-radius: 20px; 
            width: 360px; 
            box-shadow: 0 0 15px rgba(255, 232, 31, 0.3);
        }
        .form-control { background-color: #222; border-color: #444; color: #fff; }
        .form-control:focus { background-color: #222; color: #fff; border-color: #ffe81f; box-shadow: none; }
        .btn-warning { font-weight: bold; }
    </style>
</head>
<body onload="initDatabase()">

    <div class="login-card text-center">
        <h4 class="text-warning mb-4">IDENTIFICACIÓN</h4>
        <input type="text" id="userInput" placeholder="Nombre de usuario" class="form-control mb-2">
        <input type="password" id="passInput" placeholder="Contraseña" class="form-control mb-3">
        
        <button onclick="login()" class="btn btn-warning w-100 mb-2">ENTRAR</button>
        <button onclick="registrar()" class="btn btn-outline-secondary btn-sm w-100">Registrar nuevo usuario</button>
        
        <div class="mt-3">
            <a href="index.html" class="text-muted small text-decoration-none">← Volver como invitado</a>
        </div>
    </div>

    <script>
        function initDatabase() {
            let db = JSON.parse(localStorage.getItem('usuarios')) || [];
            // Verificar si oviri existe, si no, crearlo
            if (!db.find(u => u.nombre === 'oviri')) {
                db.push({ nombre: 'oviri', clave: 'velez22' });
                localStorage.setItem('usuarios', JSON.stringify(db));
            }
        }

        function login() {
            const u = document.getElementById('userInput').value.toLowerCase().trim();
            const p = document.getElementById('passInput').value;
            const db = JSON.parse(localStorage.getItem('usuarios'));

            const found = db.find(user => user.nombre === u && user.clave === p);

            if (found) {
                localStorage.setItem('sesionActiva', JSON.stringify(found));
                window.location.href = "index.html";
            } else {
                alert("Acceso denegado. Revisa tus datos.");
            }
        }

        function registrar() {
            const u = document.getElementById('userInput').value.toLowerCase().trim();
            const p = document.getElementById('passInput').value;

            if (!u || !p) return alert("Completa ambos campos.");

            let db = JSON.parse(localStorage.getItem('usuarios'));

            if (db.find(user => user.nombre === u)) {
                return alert("Este nombre de usuario ya está registrado.");
            }

            const nuevoUsuario = { nombre: u, clave: p };
            db.push(nuevoUsuario);
            localStorage.setItem('usuarios', JSON.stringify(db));
            
            // Auto-login al registrarse
            localStorage.setItem('sesionActiva', JSON.stringify(nuevoUsuario));
            alert("¡Usuario creado con éxito! Entrando...");
            window.location.href = "index.html";
        }
    </script>
</body>
</html>
